# ===== FitForge 配置模板 =====
# 复制本文件为 .env 并填入真实值（.env 已加入 .gitignore，永远不入 Git）

# ===== 数据库 =====
# 运行时用（FastAPI + asyncmy）
DATABASE_URL=mysql+asyncmy://fitforge:CHANGE_ME@localhost:3306/fitforge
# Alembic autogenerate 用（pymysql 同步）
SYNC_DATABASE_URL=mysql+pymysql://fitforge:CHANGE_ME@localhost:3306/fitforge

# ===== JWT（RS256 签名）=====
# 私钥/公钥文件路径（用 openssl 生成：见 tech_notes）
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
# Token 过期时间（分钟）：默认 24 小时
JWT_EXPIRE_MINUTES=1440

# ===== 应用元信息 =====
APP_NAME=FitForge
APP_VERSION=0.1.0
DEBUG=false

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FILE=logs/fitforge.log