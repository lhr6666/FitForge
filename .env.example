# ===== FitForge 配置模板 =====
# 复制本文件为 .env 并填入真实值（.env 已加入 .gitignore，永远不入 Git）

# ===== 数据库（MySQL 异步）=====
# 格式：mysql+asyncmy://用户名:密码@host:port/数据库名
DATABASE_URL=mysql+asyncmy://fitforge:CHANGE_ME@localhost:3306/fitforge

# ===== JWT（RS256 签名）=====
# 私钥/公钥文件路径（用 openssl 生成：见 README/tech_notes）
PRIVATE_KEY_PATH=keys/private.pem
PUBLIC_KEY_PATH=keys/public.pem
# Token 过期时间（分钟）：默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 应用元信息 =====
APP_NAME=FitForge
APP_VERSION=0.1.0
DEBUG=true

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FILE=logs/fitforge.log